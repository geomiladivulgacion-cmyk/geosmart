---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const projects = `${base}projects/`;
const fieldNotes = `${base}field-notes/`;
const about = `${base}about/`;
const cv = `${base}documents/Curriculum_CamilaFernández-9.pdf`;
const heroImage = 'https://imaggeo.egu.eu/media/uploads/2013/12/19/1725/1f6b3e1ca9f48ec2a4f060e51c1d7eba81fe73cd66f562f676fcf68d44af4c45.jpg';
---
<BaseLayout title="GeoSmart — Camila Fernández" description="Camila Fernández — geology undergraduate exploring the subsurface through geology, geophysics and clear scientific communication.">
  <section class="hero">
    <div class="hero-photo" aria-label="Gneiss landscape in Sunnmøre, Norway">
      <img src={heroImage} alt="Gneiss landscape in Sunnmøre, Norway" />
      <div class="hero-photo-overlay"></div>
      <div class="hero-visual-label">GEOLOGY / FIELD / NORWAY</div>
      <div class="depth-label">subsurface</div>
      <div class="photo-credit">Photo: Halfdan Carstens / Imaggeo</div>
    </div>

    <div class="container hero-grid">
      <div class="hero-content">
        <div class="eyebrow">GeoSmart · Camila Fernández</div>
        <h1>Reading the Earth<br /><span>from surface to subsurface.</span></h1>
        <p>Geological thinking, project coordination and scientific communication — brought together by a geology undergraduate building towards subsurface and offshore geoscience.</p>
        <div class="hero-actions">
          <a class="btn" href={projects}>Explore my work →</a>
          <a class="text-link" href={about}>Get to know me</a>
        </div>
      </div>
    </div>
  </section>

  <section class="container intro-strip">
    <div><span class="strip-number">01</span><strong>Geoscience</strong><p>Sedimentology · Geophysics · Subsurface · Energy</p></div>
    <div><span class="strip-number">02</span><strong>Methods</strong><p>QGIS · SedLog · Seismic interpretation · Data analysis</p></div>
    <div><span class="strip-number">03</span><strong>Perspective</strong><p>Science, field observations and clear communication</p></div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div><div class="section-kicker">Selected work</div><h2>Things I’m exploring</h2></div>
        <p class="muted">A growing collection of university projects, geological observations and interpretations — presented as work I can actually show, explain and learn from.</p>
      </div>
      <div class="projects-grid">
        <a class="card" href={projects}><div class="card-image seismic-card"><span>01 / SEISMIC</span></div><div class="card-body"><div class="card-tag">Geophysics</div><h3>Seismic Interpretation</h3><p>Academic work exploring how seismic evidence can be translated into geological interpretations.</p></div></a>
        <a class="card" href={projects}><div class="card-image sediment-card"><span>02 / SEDIMENTS</span></div><div class="card-body"><div class="card-tag">Sedimentology</div><h3>Sedimentary Environments</h3><p>Coursework connecting observations, sedimentary structures and depositional environments.</p></div></a>
        <a class="card" href={projects}><div class="card-image gis-card"><span>03 / MAPPING</span></div><div class="card-body"><div class="card-tag">GIS</div><h3>Geological Mapping</h3><p>Maps, spatial data and geological reasoning brought together through GIS-based work.</p></div></a>
      </div>
    </div>
  </section>

  <section class="section notes-section">
    <div class="container">
      <div class="notes">
        <article class="note-feature">
          <div class="section-kicker">A little more personal</div>
          <h2>Why geology?</h2>
          <p>I like geology because it sits somewhere between detective work and science: you rarely get to see the whole story, so you learn to build it from evidence.</p>
          <p class="muted">GeoSmart is my space to document that process — what I’m learning, what I’m working on and where I want to take it next.</p>
          <a class="btn" href={about}>Read my story →</a>
        </article>
        <aside class="cv-callout">
          <div class="card-tag">Looking for the professional version?</div>
          <h3>Want to know what I can do?</h3>
          <p>For the full picture — experience, education, skills and certifications — have a look at my CV.</p>
          <a class="text-link dark" href={cv} target="_blank" rel="noopener noreferrer">View my CV →</a>
        </aside>
      </div>
    </div>
  </section>

  <section class="section field-section">
    <div class="container">
      <div class="section-head">
        <div><div class="section-kicker">Latest from GeoSmart</div><h2>Field Notes</h2></div>
        <a class="text-link dark" href={fieldNotes}>See all notes →</a>
      </div>
      <div class="note-list home-notes">
        <article class="note"><div class="card-tag">Geophysics</div><h4>Why does seismic interpretation actually matter?</h4><p class="muted">Seismic data is more than pretty lines on a screen. It is a window into the Earth's history and a tool for understanding structures, resources and risk.</p></article>
        <article class="note"><div class="card-tag">Norway</div><h4>Geology in Trondheim</h4><p class="muted">Field notes from a geology student discovering Norway.</p></article>
        <article class="note"><div class="card-tag">Learning</div><h4>Things I wish I knew before studying geology</h4><p class="muted">Lessons from the first years of a geological education.</p></article>
      </div>
    </div>
  </section>
</BaseLayout>
