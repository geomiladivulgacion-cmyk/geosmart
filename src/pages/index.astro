---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const projects = `${base}projects/`;
const fieldNotes = `${base}field-notes/`;
const about = `${base}about/`;
const cv = `${base}documents/Curriculum_CamilaFern%C3%A1ndez-10.pdf`;
const heroImage = 'https://imaggeo.egu.eu/media/uploads/2013/12/19/1725/1f6b3e1ca9f48ec2a4f060e51c1d7eba81fe73cd66f562f676fcf68d44af4c45.jpg';
---
<BaseLayout title="GeoSmart — Camila Fernández" description="Camila Fernández — geology undergraduate exploring subsurface and offshore geoscience through geology, geophysics and scientific communication.">
  <section class="hero">
    <div class="hero-photo" aria-label="Gneiss landscape in Sunnmøre, Norway">
      <img src={heroImage} alt="Gneiss landscape in Sunnmøre, Norway" />
      <div class="hero-photo-overlay"></div>
      <div class="hero-visual-label">GEOLOGY / FIELD / NORWAY</div>
      <div class="depth-label">subsurface</div>
      <div class="photo-credit">Photo: Halfdan Carstens / Imaggeo</div>
    </div>

    <div class="container hero-grid">
      <div class="hero-content">
        <div class="eyebrow">GeoSmart · Camila Fernández</div>
        <div class="hero-role">Geology undergraduate · Subsurface · Scientific communication</div>
        <h1>Reading the Earth<br /><span>from surface to subsurface.</span></h1>
        <p>I’m a geology undergraduate interested in what happens beneath our feet — and in finding better ways to understand, interpret and explain it.</p>
        <div class="hero-actions">
          <a class="btn" href={projects}>Explore my work →</a>
          <a class="text-link" href={about}>Get to know me</a>
        </div>
      </div>
    </div>
  </section>

  <section class="container intro-strip">
    <div><span class="strip-number">01</span><strong>Geoscience</strong><p>Sedimentology · Geophysics · Subsurface · Energy</p></div>
    <div><span class="strip-number">02</span><strong>Methods</strong><p>QGIS · SedLog · Seismic interpretation · Data analysis</p></div>
    <div><span class="strip-number">03</span><strong>Perspective</strong><p>Curiosity · Critical thinking · Scientific communication</p></div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div><div class="section-kicker">Selected work</div><h2>Things I’m exploring</h2></div>
        <p class="muted">A small selection of geological work I’m especially proud of. For the full collection, head to Projects.</p>
      </div>
      <div class="projects-grid home-projects-grid">
        <a class="card" href={projects}><div class="card-image home-cover cover-01" aria-label="Regional metapelites project cover"><img src="/images/Gemini_Generated_Image_or8be5or8be5or8b.jpg" alt="Regional metapelites project cover" loading="lazy" /></div><div class="card-body"><div class="card-tag">Regional metamorphism</div><h3>Regional Metamorphism of Metapelites</h3><p>Field, structural and petrographic study of the Somosierra–Hayedo de Montejo–Berzosa area, including metamorphic zonation and P–T evolution.</p></div></a>
        <a class="card" href={projects}><div class="card-image home-cover cover-reservoir" aria-label="Petroleum reservoir project cover"><img src="/images/Gemini_Generated_Image_ml0d26ml0d26ml0d.jpg" alt="Petroleum reservoir project cover" loading="lazy" /></div><div class="card-body"><div class="card-tag">Petroleum engineering · Reservoir characterization</div><h3>Reservoir Engineering</h3><p>Study of fluid distribution in an anticlinal reservoir, effective porosity, uncertainty analysis and helium porosimetry.</p></div></a>
        <a class="card" href={projects}><div class="card-image home-cover cover-05" aria-label="Peñarroya reservoir basin hydrology project cover"><img src="/images/Gemini_Generated_Image_hsgd01hsgd01hsgd.jpg" alt="Peñarroya reservoir basin hydrology project cover" loading="lazy" /></div><div class="card-body"><div class="card-tag">Hydrology · QGIS</div><h3>Hydrological Study of the Peñarroya Reservoir Basin</h3><p>Hydrological analysis of the Campo de Montiel basin combining watershed delineation, water balance, evapotranspiration and runoff methods.</p></div></a>
      </div>
    </div>
  </section>

  <section class="section notes-section">
    <div class="container">
      <div class="notes">
        <article class="note-feature">
          <div class="section-kicker">A little more personal</div>
          <h2>Why geology?</h2>
          <p>I like geology because it sits somewhere between detective work and science: you rarely get to see the whole story, so you learn to build it from evidence.</p>
          <p class="muted">GeoSmart is my space to document that process — what I’m learning, what I’m working on and where I want to take it next.</p>
          <a class="btn" href={about}>Read my story →</a>
        </article>
        <aside class="cv-callout">
          <div class="card-tag">Looking for the professional version?</div>
          <h3>Want to know what I can do?</h3>
          <p>Experience, education, certifications, skills and the rest of the professional picture are all in my CV.</p>
          <a class="text-link dark" href={cv} target="_blank" rel="noopener noreferrer">View my CV →</a>
        </aside>
      </div>
    </div>
  </section>

  <section class="section field-section">
    <div class="container">
      <div class="section-head">
        <div><div class="section-kicker">Latest from GeoSmart</div><h2>Field Notes</h2></div>
        <a class="text-link dark" href={fieldNotes}>See all notes →</a>
      </div>
      <div class="note-list home-notes">
        <article class="note"><div class="card-tag">Glacial geomorphology</div><h4>Tracing Deglaciation: Zackenberg Valley &amp; Aneto Glacier</h4><p class="muted">Glacial landforms, <sup>10</sup>Be geochronology, remote sensing and glacier retreat across Arctic and alpine environments.</p><a class="text-link dark" href={fieldNotes}>Read Field Note 01 →</a></article>
        <article class="note"><div class="card-tag">Global tectonics</div><h4>How Plate Tectonics Works: Forces, Rheology &amp; Deformation</h4><p class="muted">A synthesis of plate-driving forces, rheology, subduction geometry and the deformation they produce.</p><a class="text-link dark" href={fieldNotes}>Read Field Note 02 →</a></article>
        <article class="note"><div class="card-tag">Metamorphic field geology</div><h4>Mapping a Metamorphic Terrane: Prádena &amp; Berzosa</h4><p class="muted">Regional and detailed geological mapping connecting metamorphic zonation, structures and Variscan tectonic evolution.</p><a class="text-link dark" href={fieldNotes}>Read Field Note 03 →</a></article>
      </div>   </div>
  </section>
</BaseLayout>

<style>
.hero-role{margin-top:-6px;margin-bottom:18px;color:rgba(255,255,255,.82);font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.home-projects-grid{grid-template-columns:repeat(3,1fr)}
.home-projects-grid .card{overflow:hidden}
.home-projects-grid .card-image{aspect-ratio:1376 / 768}
.home-projects-grid .card h3{font-size:1.2rem}
.home-projects-grid .card p{font-size:.8rem}
.home-cover{position:relative;background-color:var(--cream);overflow:hidden}
.home-cover img{position:absolute;inset:0;width:100%;height:100%;display:block;object-fit:cover;object-position:center;z-index:0}

@media(max-width:1000px){.home-projects-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:520px){.home-projects-grid{grid-template-columns:1fr}}
</style>
