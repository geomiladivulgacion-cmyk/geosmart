---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const projects = `${base}projects/`;
const fieldNotes = `${base}field-notes/`;
const about = `${base}about/`;
const cv = 'https://geomiladivulgacion-cmyk.github.io/geosmart/documents/curriculum-camila-fernandez.pdf';
const heroImage = 'https://imaggeo.egu.eu/media/uploads/2013/12/19/1725/1f6b3e1ca9f48ec2a4f060e51c1d7eba81fe73cd66f562f676fcf68d44af4c45.jpg';
---
<BaseLayout title="GeoSmart — Camila Fernández" description="Camila Fernández — geology undergraduate exploring subsurface and offshore geoscience through geology, geophysics and scientific communication.">
  <section class="hero">
    <div class="hero-photo" aria-label="Gneiss landscape in Sunnmøre, Norway">
      <img src={heroImage} alt="Gneiss landscape in Sunnmøre, Norway" />
      <div class="hero-photo-overlay"></div>
      <div class="hero-visual-label">GEOLOGY / FIELD / NORWAY</div>
      <div class="depth-label">subsurface</div>
      <div class="photo-credit">Photo: Halfdan Carstens / Imaggeo</div>
    </div>

    <div class="container hero-grid">
      <div class="hero-content">
        <div class="eyebrow">GeoSmart · Camila Fernández</div>
        <h1>Reading the Earth<br /><span>from surface to subsurface.</span></h1>
        <p>I’m a geology undergraduate interested in what happens beneath our feet — and in finding better ways to understand, interpret and explain it.</p>
        <div class="hero-actions">
          <a class="btn" href={projects}>Explore my work →</a>
          <a class="text-link" href={about}>Get to know me</a>
        </div>
      </div>
    </div>
  </section>

  <section class="container intro-strip">
    <div><span class="strip-number">01</span><strong>Geoscience</strong><p>Sedimentology · Geophysics · Subsurface · Energy</p></div>
    <div><span class="strip-number">02</span><strong>Methods</strong><p>QGIS · SedLog · Seismic interpretation · Data analysis</p></div>
    <div><span class="strip-number">03</span><strong>Perspective</strong><p>Curiosity · Critical thinking · Scientific communication</p></div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div><div class="section-kicker">Selected work</div><h2>Things I’m exploring</h2></div>
        <p class="muted">A small selection of geological work I’m especially proud of. For the full collection, head to Projects.</p>
      </div>
      <div class="projects-grid home-projects-grid">
        <a class="card" href={projects}><div class="card-image home-regional-card"><span>01 / REGIONAL</span></div><div class="card-body"><div class="card-tag">Regional metamorphism</div><h3>Regional Metamorphism of Metapelites</h3><p>Field, structural and petrographic study of the Somosierra–Hayedo de Montejo–Berzosa area, including metamorphic zonation and P–T evolution.</p></div></a>
        <a class="card" href={projects}><div class="card-image home-santa-card"><span>02 / FIELD STUDY</span></div><div class="card-body"><div class="card-tag">Field geology · Structural geology</div><h3>Santa María de la Alameda</h3><p>Geological mapping and tectonometamorphic interpretation of orthogneisses, leucogneisses, migmatites and ductile shear zones.</p></div></a>
        <a class="card" href={projects}><div class="card-image home-hydrology-card"><span>03 / HYDROLOGY</span></div><div class="card-body"><div class="card-tag">Hydrology · QGIS</div><h3>Hydrological Study of the Peñarroya Reservoir Basin</h3><p>Hydrological analysis of the Campo de Montiel basin combining watershed delineation, water balance, evapotranspiration and runoff methods.</p></div></a>
      </div>
    </div>
  </section>

  <section class="section notes-section">
    <div class="container">
      <div class="notes">
        <article class="note-feature">
          <div class="section-kicker">A little more personal</div>
          <h2>Why geology?</h2>
          <p>I like geology because it sits somewhere between detective work and science: you rarely get to see the whole story, so you learn to build it from evidence.</p>
          <p class="muted">GeoSmart is my space to document that process — what I’m learning, what I’m working on and where I want to take it next.</p>
          <a class="btn" href={about}>Read my story →</a>
        </article>
        <aside class="cv-callout">
          <div class="card-tag">Looking for the professional version?</div>
          <h3>Want to know what I can do?</h3>
          <p>Experience, education, certifications, skills and the rest of the professional picture are all in my CV.</p>
          <a class="text-link dark" href={cv} target="_blank" rel="noopener noreferrer">View my CV →</a>
        </aside>
      </div>
    </div>
  </section>

  <section class="section field-section">
    <div class="container">
      <div class="section-head">
        <div><div class="section-kicker">Latest from GeoSmart</div><h2>Field Notes</h2></div>
        <a class="text-link dark" href={fieldNotes}>See all notes →</a>
      </div>
      <div class="note-list home-notes">
        <article class="note"><div class="card-tag">Geophysics</div><h4>Why does seismic interpretation actually matter?</h4><p class="muted">A look at why seismic interpretation is more than reading lines — it is geological reasoning under uncertainty.</p></article>
        <article class="note"><div class="card-tag">Norway</div><h4>Geology in Trondheim</h4><p class="muted">What starts to change when you look at an everyday Norwegian landscape with a geologist’s eye.</p></article>
        <article class="note"><div class="card-tag">Learning</div><h4>Things I wish I knew before studying geology</h4><p class="muted">Lessons from learning to read maps, rocks, data and — eventually — my own mistakes.</p></article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.home-projects-grid{grid-template-columns:repeat(3,1fr)}
.home-projects-grid .card{overflow:hidden}
.home-projects-grid .card-image{aspect-ratio:1.35/1;min-height:170px}
.home-projects-grid .card h3{font-size:1.2rem}
.home-projects-grid .card p{font-size:.8rem}
.home-regional-card{background:linear-gradient(135deg,#122f30 0%,#0f3d3e 42%,#f58220 43%,#d38d52 100%)}
.home-contact-card{background:linear-gradient(135deg,#1a4747 0%,#2a615b 38%,#d7a15f 39%,#f2dfc9 100%)}
.home-metabasite-card{background:linear-gradient(135deg,#0f3d3e 0%,#214d4e 48%,#b9a06d 49%,#e8dcc6 100%)}
.home-santa-card{background:linear-gradient(135deg,#173f3e 0%,#527568 48%,#c4a16e 49%,#f0e4d0 100%)}
.home-hydrology-card{background:linear-gradient(135deg,#123e40 0%,#286a64 44%,#82a59a 45%,#d8c395 100%)}
@media(max-width:1000px){.home-projects-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:520px){.home-projects-grid{grid-template-columns:1fr}.home-projects-grid .card-image{min-height:190px}}
</style>
