---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const projects = `${base}projects/`;
const fieldNotes = `${base}field-notes/`;
const about = `${base}about/`;
const cv = `${base}documents/Curriculum_CamilaFern%C3%A1ndez-10.pdf`;
const heroImage = 'https://imaggeo.egu.eu/media/uploads/2013/12/19/1725/1f6b3e1ca9f48ec2a4f060e51c1d7eba81fe73cd66f562f676fcf68d44af4c45.jpg';
---
<BaseLayout title="GeoSmart — Camila Fernández | Petroleum & Offshore Geoscience" description="Camila Fernández is a Geology undergraduate at UCM, currently undertaking petroleum-focused geoscience coursework at NTNU, with interests in subsurface interpretation, reservoir characterization and offshore geoscience.">
  <section class="hero">
    <div class="hero-photo" aria-label="Gneiss landscape in Sunnmøre, Norway">
      <img src={heroImage} alt="Gneiss landscape in Sunnmøre, Norway" />
      <div class="hero-photo-overlay"></div>
      <div class="hero-visual-label">GEOLOGY / FIELD / NORWAY</div>
      <div class="depth-label">subsurface</div>
      <div class="photo-credit">Photo: Halfdan Carstens / Imaggeo</div>
    </div>

    <div class="container hero-grid">
      <div class="hero-content">
        <div class="eyebrow">GeoSmart · Camila Fernández</div>
        <div class="hero-role">Geology undergraduate · Petroleum &amp; offshore geoscience</div>
        <h1>Understanding the Earth<br /><span>beneath the surface.</span></h1>
        <p>Building a path towards subsurface and offshore geoscience through geological interpretation, reservoir studies and petroleum-focused coursework at NTNU.</p>
        <div class="hero-actions">
          <a class="btn" href={projects}>Explore my work →</a>
          <a class="text-link" href={about}>Get to know me</a>
        </div>
      </div>
    </div>
  </section>

  <section class="container intro-strip">
    <div><span class="strip-number">01</span><strong>Focus</strong><p>Petroleum geology · Subsurface · Offshore</p></div>
    <div><span class="strip-number">02</span><strong>Developing</strong><p>Reservoir characterization · Geophysics · Petrophysics</p></div>
    <div><span class="strip-number">03</span><strong>Foundation</strong><p>Field geology · Sedimentology · Structural interpretation</p></div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div><div class="section-kicker">Selected work</div><h2>Selected subsurface &amp; basin work</h2></div>
        <p class="muted">A curated selection showing how I approach reservoir properties, basin evolution and the geological evidence behind subsurface systems.</p>
      </div>
      <div class="projects-grid home-projects-grid">
        <a class="card" href={projects}><div class="card-image home-cover cover-reservoir" aria-label="Petroleum reservoir project cover"><img src="/images/Gemini_Generated_Image_ml0d26ml0d26ml0d.jpg" alt="Petroleum reservoir project cover" loading="lazy" /></div><div class="card-body"><div class="card-tag">Petroleum engineering · Reservoir characterization</div><h3>Reservoir Engineering</h3><p>Fluid distribution in an anticlinal reservoir, effective porosity calculations, uncertainty analysis and helium porosimetry.</p></div></a>
        <a class="card" href={projects}><div class="card-image home-cover cover-sedimentary"><img src="/images/field-notes.png" alt="Geological field landscape for sedimentary basin study" loading="lazy" /></div><div class="card-body"><div class="card-tag">Sedimentary geology · Basin analysis</div><h3>Tectono-Sedimentary Basin Evolution</h3><p>Field and petrographic comparison of semigraben and pull-apart basins, linking sedimentary records with basin architecture.</p></div></a>
        <a class="card" href={projects}><div class="card-image home-cover cover-01"><img src="/images/Gemini_Generated_Image_or8be5or8be5or8b.jpg" alt="Regional metamorphic geology project cover" loading="lazy" /></div><div class="card-body"><div class="card-tag">Metamorphic petrology · Structural geology</div><h3>Regional Metamorphism of Metapelites</h3><p>Field, structural and petrographic interpretation of metamorphic zonation and P–T evolution in the Somosierra–Berzosa area.</p></div></a>
      </div>    </div>
  </section>

  <section class="section experience-strip"><div class="container"><div class="section-head"><div><div class="section-kicker">Beyond coursework</div><h2>Experience in operational environments</h2></div><p class="muted">A practical complement to my geological training.</p></div><div class="experience-grid"><article><span>01 / DOCUMENTATION</span><h3>Project &amp; work-control support</h3><p>Drilling-rig documentation, work-control records and coordination support.</p></article><article><span>02 / SAFETY</span><h3>Operational safety support</h3><p>Safety assistance, audit support and contribution to more than 80 safety briefings.</p></article><article><span>03 / COMMUNICATION</span><h3>Technical &amp; cross-team communication</h3><p>Clear documentation and coordination across people, processes and working environments.</p></article></div></div></section>

  <section class="section notes-section">
    <div class="container">
      <div class="notes">
        <article class="note-feature">
          <div class="section-kicker">Professional direction</div>
          <h2>From geological evidence to the subsurface.</h2>
          <p>I’m interested in how geological systems shape the distribution, quality and behaviour of subsurface resources — and how field evidence, geophysical data and reservoir analysis help us understand them.</p>
          <p class="muted">GeoSmart documents the projects, methods and learning that are shaping my path towards petroleum and offshore geoscience.</p>
          <a class="btn" href={about}>Read my story →</a>
        </article>
        <aside class="cv-callout">
          <div class="card-tag">Professional profile</div>
          <h3>Geology, operations &amp; communication.</h3>
          <p>Alongside my academic work, I bring experience in project documentation, work-control support and operational safety assistance.</p>
          <a class="text-link dark" href={cv} target="_blank" rel="noopener noreferrer">View my CV →</a>
        </aside>
      </div>
    </div>
  </section>

  <section class="section field-section">
    <div class="container">
      <div class="section-head">
        <div><div class="section-kicker">Latest from GeoSmart</div><h2>Field Notes</h2></div>
        <a class="text-link dark" href={fieldNotes}>See all notes →</a>
      </div>
      <div class="note-list home-notes">
        <article class="note"><div class="card-tag">Glacial geomorphology</div><h4>Tracing Deglaciation: Zackenberg Valley &amp; Aneto Glacier</h4><p class="muted">Glacial landforms, <sup>10</sup>Be geochronology, remote sensing and glacier retreat across Arctic and alpine environments.</p><a class="text-link dark" href={fieldNotes}>Read Field Note 01 →</a></article>
        <article class="note"><div class="card-tag">Global tectonics</div><h4>How Plate Tectonics Works: Forces, Rheology &amp; Deformation</h4><p class="muted">A synthesis of plate-driving forces, rheology, subduction geometry and the deformation they produce.</p><a class="text-link dark" href={fieldNotes}>Read Field Note 02 →</a></article>
        <article class="note"><div class="card-tag">Metamorphic field geology</div><h4>Mapping a Metamorphic Terrane: Prádena &amp; Berzosa</h4><p class="muted">Regional and detailed geological mapping connecting metamorphic zonation, structures and Variscan tectonic evolution.</p><a class="text-link dark" href={fieldNotes}>Read Field Note 03 →</a></article>
      </div>   </div>
  </section>
</BaseLayout>

<style>
.hero-role{margin-top:-6px;margin-bottom:18px;color:rgba(255,255,255,.82);font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.home-projects-grid{grid-template-columns:repeat(3,1fr)}
.home-projects-grid .card{overflow:hidden}
.home-projects-grid .card-image{aspect-ratio:1376 / 768}
.home-projects-grid .card h3{font-size:1.2rem}
.home-projects-grid .card p{font-size:.8rem}
.home-cover{position:relative;background-color:var(--cream);overflow:hidden}
.experience-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.experience-grid article{padding:24px;border-top:3px solid var(--orange);background:#fffdf9}
.experience-grid article>span{font-size:.58rem;letter-spacing:.14em;font-weight:800;color:var(--orange)}
.experience-grid h3{margin:12px 0 8px;color:var(--green);font-size:1.15rem}
.experience-grid p{margin:0;color:#59615e;font-size:.88rem}
@media(max-width:800px){.experience-grid{grid-template-columns:1fr}}
.home-cover img{position:absolute;inset:0;width:100%;height:100%;display:block;object-fit:cover;object-position:center;z-index:0}

@media(max-width:1000px){.home-projects-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:520px){.home-projects-grid{grid-template-columns:1fr}}
</style>
