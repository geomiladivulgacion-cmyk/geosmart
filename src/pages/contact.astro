---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — GeoSmart" description="Contact Camila Fernández for academic collaborations, geological conversations, science outreach and professional opportunities.">
  <section class="page-hero">
    <div class="container">
      <div class="section-kicker">Let's connect</div>
      <h1>Contact</h1>
      <p class="muted">Open to interesting geological problems, academic collaborations, outreach and professional opportunities.</p>
    </div>
  </section>
  <section class="page">
    <div class="container">
      <div class="contact-box contact-box-large">
        <div class="section-kicker">Get in touch</div>
        <h2>Have something interesting to talk about?</h2>
        <p>Whether it's a geological project, a collaboration, a question about GeoSmart or an opportunity worth exploring, I'd be happy to hear from you.</p>
        <div class="contact-details">
          <a href="mailto:c.fernandez@geosmart.es"><span>Email</span><strong>c.fernandez@geosmart.es</strong></a>
          <a href="https://www.linkedin.com/in/camila-isabel-fernández-riveras-190b4a384/es/" target="_blank" rel="noopener noreferrer"><span>LinkedIn</span><strong>Camila Fernández</strong></a>
          <a href="https://www.instagram.com/_geomila_/" target="_blank" rel="noopener noreferrer"><span>Science outreach</span><strong>@_geomila_</strong></a>
        </div>
      </div>
    </div>
  </section>
