---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — GeoSmart" description="Contact Camila Fernández for geological collaborations, student opportunities, science communication and professional conversations.">
  <section class="page-hero">
    <div class="container">
      <div class="section-kicker">Let's connect</div>
      <h1>Contact</h1>
      <p class="muted">Interested in geology, science communication, collaboration or a professional opportunity? I'd be glad to hear from you.</p>
    </div>
  </section>

  <section class="page">
    <div class="container">
      <div class="contact-box contact-box-large">
        <div class="section-kicker">Get in touch</div>
        <h2>Let's talk geology.</h2>
        <p>Maybe you have a project in mind, an interesting geological question, an academic opportunity, a collaboration idea — or simply found something on GeoSmart worth talking about. I'm always happy to hear from curious people.</p>
        <div class="contact-details">
          <a href="mailto:c.fernandez@geosmart.es"><span>Email</span><strong>c.fernandez@geosmart.es</strong></a>
          <a href="tel:+34640118331"><span>Phone</span><strong>+34 640 118 331</strong></a>
          <a href="https://www.linkedin.com/in/camila-isabel-fernández-riveras-190b4a384/es/" target="_blank" rel="noopener noreferrer"><span>LinkedIn</span><strong>Camila Fernández</strong></a>
          <a href="https://www.instagram.com/_geomila_/" target="_blank" rel="noopener noreferrer"><span>Science outreach</span><strong>@_geomila_</strong></a>
        </div>
      </div>

      <div class="section-head" style="margin-top:70px; margin-bottom:0;">
        <div>
          <div class="section-kicker">What I'm open to</div>
          <h2>Good conversations can start anywhere.</h2>
        </div>
        <p class="muted">Academic collaborations · student opportunities · geoscience projects · science outreach · international work · ideas worth exploring.</p>
      </div>
    </div>
  </section>
</BaseLayout>
