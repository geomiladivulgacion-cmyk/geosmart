---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — GeoSmart" description="Contact Camila Fernández for geological collaborations, student opportunities, science communication and professional conversations.">
  <section class="page-hero contact-hero">
    <div class="container">
      <div class="section-kicker">Let's connect</div>
      <h1>Contact</h1>
      <p class="muted">Interested in geology, science communication, collaboration or a professional opportunity? I'd be glad to hear from you.</p>
      <div class="contact-coordinate" aria-hidden="true">40° N · 3° W → 63° N · 10° E</div>
    </div>
  </section>

  <section class="page contact-page">
    <div class="container">
      <div class="contact-intro"><span class="section-kicker">Open channel</span><p>Good conversations can start with a question, a project, a map or simply a “hey, I found your work interesting.”</p></div>
      <div class="contact-box contact-box-large">
        <div class="contact-orbit" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="section-kicker">Get in touch</div>
        <h2>Let's talk geology.</h2>
        <p>Maybe you have a project in mind, an interesting geological question, an academic opportunity, a collaboration idea — or simply found something on GeoSmart worth talking about. I'm always happy to hear from curious people.</p>
        <div class="contact-details">
          <a href="mailto:c.fernandez@geosmart.es"><span>Email</span><strong>c.fernandez@geosmart.es</strong><small>Best for professional enquiries</small></a>
          <a href="tel:+34640118331"><span>Phone</span><strong>+34 640 118 331</strong><small>Spain · international calls welcome</small></a>
          <a href="https://www.linkedin.com/in/camila-isabel-fernández-riveras-190b4a384/es/" target="_blank" rel="noopener noreferrer"><span>LinkedIn</span><strong>Camila Fernández</strong><small>Professional profile</small></a>
          <a href="https://www.instagram.com/_geomila_/" target="_blank" rel="noopener noreferrer"><span>Science outreach</span><strong>@_geomila_</strong><small>Geology, curiosity &amp; science</small></a>
        </div>
      </div>

      <div class="section-head contact-open" style="margin-top:70px; margin-bottom:0;">
        <div><div class="section-kicker">What I'm open to</div><h2>Good conversations can start anywhere.</h2></div>
        <p class="muted">Academic collaborations · student opportunities · geoscience projects · science outreach · international work · ideas worth exploring.</p>
      </div>
      <div class="contact-signoff"><span>GEO · SMART</span><p>Read the Earth. Ask better questions.</p></div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero { position:relative; overflow:hidden; }
  .contact-hero::before { content:'@'; position:absolute; right:8%; top:8%; color:rgba(15,61,62,.06); font:600 16rem/1 'Playfair Display',serif; }
  .contact-coordinate { margin-top:30px; color:rgba(15,61,62,.5); font-size:.62rem; font-weight:700; letter-spacing:.15em; }
  .contact-intro { display:flex; justify-content:space-between; align-items:flex-end; gap:40px; margin-bottom:34px; }
  .contact-intro p { max-width:620px; margin:0; color:#69706d; font:500 1.2rem/1.45 'Playfair Display',serif; }
  .contact-box-large { position:relative; overflow:hidden; box-shadow:0 22px 55px rgba(15,61,62,.12); }
  .contact-orbit { position:absolute; right:8%; top:12%; width:170px; height:170px; border:1px solid rgba(255,255,255,.12); border-radius:50%; opacity:.7; }
  .contact-orbit::before,.contact-orbit::after { content:''; position:absolute; inset:19px; border:1px solid rgba(245,130,32,.2); border-radius:50%; }
  .contact-orbit::after { inset:48px; }
  .contact-orbit span { position:absolute; width:6px; height:6px; background:var(--orange); border-radius:50%; }
  .contact-orbit span:nth-child(1){top:12px;left:80px}.contact-orbit span:nth-child(2){right:15px;bottom:43px}.contact-orbit span:nth-child(3){left:35px;bottom:15px}
  .contact-details { grid-template-columns:repeat(2,1fr); position:relative; z-index:1; }
  .contact-details a { transition:transform .2s ease, border-color .2s ease; }
  .contact-details a:hover { transform:translateY(-3px); }
  .contact-details small { color:rgba(255,255,255,.5); font-size:.68rem; }
  .contact-signoff { display:flex; justify-content:space-between; align-items:center; padding:28px 4px 0; color:#69706d; }
  .contact-signoff span { color:var(--orange); font-size:.62rem; font-weight:700; letter-spacing:.2em; }
  .contact-signoff p { margin:0; font:italic 1.15rem 'Playfair Display',serif; color:var(--green); }
  @media (max-width:800px){.contact-hero::before{font-size:9rem;right:2%;top:12%}.contact-intro{display:block}.contact-intro p{margin-top:14px}.contact-details{grid-template-columns:1fr}.contact-orbit{width:120px;height:120px;right:-25px;top:7%}.contact-signoff{display:block}.contact-signoff p{margin-top:8px}}
</style>