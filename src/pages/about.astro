.about-page{background:linear-gradient(180deg,#fffdf9 0%,#f6efe7 52%,#fffdf9 100%);position:relative}.about-page::before{content:'FIELD PROFILE · CAMILA FERNÁNDEZ';position:absolute;right:2.5rem;top:9rem;writing-mode:vertical-rl;color:rgba(15,61,62,.14);font-size:.55rem;font-weight:800;letter-spacing:.22em}.profile-photo{border-radius:0 36px 0 36px;overflow:hidden;background:var(--green)}.profile-caption span:first-child{color:var(--orange)}.prose{position:relative}.prose::before{content:'';position:absolute;left:-65px;top:0;width:1px;height:100%;background:linear-gradient(var(--orange),transparent 18%,transparent 82%,var(--green));opacity:.25}.current-box{border-radius:0 26px 0 26px;padding:32px 35px}.focus-grid{gap:18px}.focus-card{border-radius:0 22px 0 22px;background:#fffdf9;padding:28px}.focus-card:nth-child(1){background:#e8f0ec}.focus-card:nth-child(2){background:#f8e4cf}.focus-card:nth-child(3){background:#eee7d2}.focus-card:nth-child(4){background:#f4eadf}.timeline-mini{display:grid;grid-template-columns:1fr 1fr;gap:18px}.timeline-mini p{background:#fffdf9;border-left:4px solid var(--orange);padding:20px}.about-cta{border-radius:0 38px 0 38px;padding:50px}.about-cta h2{font-size:clamp(2rem,4vw,3.2rem)}
