---
import Logo from '../components/Logo.astro';
import '../styles/global.css';
const { title = 'GeoSmart — Camila Fernández', description = 'Geoscience portfolio of Camila Fernández.' } = Astro.props;
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const cv = `${base}documents/Curriculum_CamilaFernández-9.pdf`;
const home = base;
const projects = `${base}projects/`;
const fieldNotes = `${base}field-notes/`;
const about = `${base}about/`;
const contact = `${base}contact/`;
const email = 'mailto:c.fernandez@geosmart.es';
const instagram = 'https://www.instagram.com/_geomila_/';
const linkedin = 'https://www.linkedin.com/in/camila-isabel-fernández-riveras-190b4a384/es/';
const canonical = new URL(Astro.url.pathname.replace(/^\/geosmart/, ''), 'https://geosmart.es');
const socialImage = new URL('/og-image.svg', 'https://geosmart.es');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0f3d3e" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={socialImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImage} />
  <link rel="sitemap" href={`${base}sitemap.xml`} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Camila Fernández',
    url: 'https://geosmart.es/',
    email: 'c.fernandez@geosmart.es',
    jobTitle: 'Geology Undergraduate',
    sameAs: [instagram, linkedin]
  })} />
  <title>{title}</title>
</head>
<body>
  <header class="site-header">
    <div class="container nav">
      <a class="brand" href={home}>
        <Logo />
        <span class="brand-name">GeoSmart</span>
      </a>
      <nav class="nav-links" id="main-navigation" aria-label="Main navigation">
        <a class={path === home ? 'active' : ''} href={home}>Home</a>
        <a class={path.startsWith(projects) ? 'active' : ''} href={projects}>Projects</a>
        <a class={path.startsWith(fieldNotes) ? 'active' : ''} href={fieldNotes}>Field Notes</a>
        <a class={path.startsWith(about) ? 'active' : ''} href={about}>About</a>
        <a class={path.startsWith(contact) ? 'active' : ''} href={contact}>Contact</a>
      </nav>
      <button class="menu" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="main-navigation">☰</button>
    </div>
  </header>
  <main><slot /></main>
  <footer>
    <div class="container footer-inner">
      <div>
        <div class="footer-brand">GeoSmart</div>
        <small>Camila Fernández · Geology · Subsurface · Scientific communication</small>
      </div>
      <div class="footer-links">
        <a href={projects}>Projects</a>
        <a href={about}>About</a>
        <a href={contact}>Contact</a>
      </div>
      <div class="footer-links footer-socials">
        <a href={email}>Email</a>
        <a href={instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
    </div>
  </footer>
  <script>
    const menu = document.querySelector('.menu');
    const navigation = document.querySelector('#main-navigation');
    menu?.addEventListener('click', () => {
      const open = navigation?.classList.toggle('open') ?? false;
      menu.setAttribute('aria-expanded', String(open));
      menu.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
    navigation?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        navigation.classList.remove('open');
        menu?.setAttribute('aria-expanded', 'false');
        menu?.setAttribute('aria-label', 'Open menu');
      });
    });
  </script>
</body>
</html>
